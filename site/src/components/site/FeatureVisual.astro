---
import Icon from "./Icon.astro";

export type VisualKind =
  | "parallel"
  | "resume"
  | "protocol"
  | "speed"
  | "browser"
  | "tray";

interface Props {
  kind: VisualKind;
}

const { kind } = Astro.props;

const meta: Record<VisualKind, string> = {
  parallel: "Connections",
  resume: "Resume manifest",
  protocol: "Requests",
  speed: "Speed limits",
  browser: "Browser hand-off",
  tray: "Tray",
};

const segments = [
  "is-done",
  "is-done",
  "is-done",
  "is-done",
  "is-done",
  "is-done",
  "is-done",
  "is-live",
  "is-live",
  "is-idle",
  "is-idle",
  "is-idle",
];

const ranges = [
  { label: "bytes 0–16 MiB", state: "done" },
  { label: "bytes 16–32 MiB", state: "done" },
  { label: "bytes 32–48 MiB", state: "receiving" },
  { label: "bytes 48–64 MiB", state: "queued" },
];
---

<div class="visual" aria-hidden="true">
  <div class="visual-frame">
    <div class="visual-bar">
      <span class="visual-bar-label">
        <span class="visual-bar-dot"></span>
        {meta[kind]}
      </span>
      <span class="visual-bar-meta">0.1.0</span>
    </div>

    <div class="visual-body">
      {
        kind === "parallel" && (
          <>
            <div class="visual-title-row">
              <span class="visual-title">brand-footage-4k.mp4</span>
              <span class="visual-value">68%</span>
            </div>
            <div class="segments">
              {segments.map((state) => (
                <span class={`segment ${state}`} />
              ))}
            </div>
            <div class="visual-meta-row">
              <span>8 ranges running</span>
              <span>16 MiB each</span>
              <span>3.1 MB/s</span>
            </div>
            <div class="chips">
              <span class="chip is-lit">32 max</span>
              <span class="chip">Per-site cap</span>
              <span class="chip">Global budget</span>
            </div>
          </>
        )
      }

      {
        kind === "resume" && (
          <>
            <ul class="manifest">
              {ranges.map((range) => (
                <li class={`manifest-row is-${range.state}`}>
                  <span class="manifest-code">{range.label}</span>
                  <span class="manifest-state">
                    {range.state === "done" && <Icon name="check" size={11} />}
                    {range.state === "receiving" && "receiving"}
                    {range.state === "queued" && "queued"}
                  </span>
                </li>
              ))}
            </ul>
            <p class="visual-note">
              Written beside the part files. A crash cannot lose it.
            </p>
          </>
        )
      }

      {
        kind === "protocol" && (
          <>
            <div class="protocols">
              <span class="protocol is-on">HTTP</span>
              <span class="protocol">HTTPS</span>
              <span class="protocol">FTP</span>
            </div>
            <div class="code">
              <span class="code-line">
                <span class="code-dim">GET</span> /images/brand.zip
              </span>
              <span class="code-line">
                <span class="code-dim">Range:</span> bytes=0-16777215
              </span>
            </div>
            <div class="response">
              <span class="response-code">206</span>
              Partial Content
            </div>
            <p class="visual-note">
              A server that ignores ranges falls back to one connection.
            </p>
          </>
        )
      }

      {
        kind === "speed" && (
          <>
            <div class="limit">
              <div class="limit-head">
                <span>All downloads</span>
                <span class="visual-value">2.0 MB/s</span>
              </div>
              <div class="limit-track">
                <span style="--value: 46%" />
              </div>
            </div>
            <div class="limit">
              <div class="limit-head">
                <span>This file</span>
                <span class="visual-value">800 KB/s</span>
              </div>
              <div class="limit-track">
                <span style="--value: 22%" />
              </div>
            </div>
            <div class="chips">
              <span class="chip is-lit">KB/s</span>
              <span class="chip is-lit">MB/s</span>
              <span class="chip">Applied per connection</span>
            </div>
            <p class="visual-note">
              One ceiling for the application, one for each download.
            </p>
          </>
        )
      }

      {
        kind === "browser" && (
          <>
            <div class="menu">
              <span class="menu-item">Open link in new tab</span>
              <span class="menu-item">Save link as…</span>
              <span class="menu-sep"></span>
              <span class="menu-item is-selected">
                <img src="/images/app-icon.png" alt="" width="14" height="14" />
                Download with B Download Manager
                <Icon name="check" size={12} />
              </span>
            </div>
            <p class="bridge">
              <span class="bridge-dot"></span>
              Bridge connected · localhost
            </p>
            <p class="visual-note">
              Firefox, Chrome and Edge. No native messaging host.
            </p>
          </>
        )
      }

      {
        kind === "tray" && (
          <>
            <div class="tray">
              <div class="tray-head">
                <img src="/images/app-icon.png" alt="" width="16" height="16" />
                <span class="tray-name">B Download Manager</span>
                <span class="tray-count">3 active</span>
              </div>
              <div class="tray-track">
                <span style="--value: 64%" />
              </div>
              <p class="tray-meta">Queue running · 4.8 MB/s</p>
              <div class="tray-actions">
                <span>Pause all</span>
                <span>Open</span>
                <span>Quit</span>
              </div>
            </div>
            <p class="visual-note">
              Closing the window hides it. The queue keeps going.
            </p>
          </>
        )
      }
    </div>
  </div>
</div>

<style>
  .visual {
    width: 100%;
  }

  .visual-frame {
    overflow: hidden;
    border: 1px solid var(--figure-border);
    border-radius: var(--radius-md);
    background-color: var(--figure-bg);
    color: var(--figure-ink);
    box-shadow: var(--shadow-panel);
  }

  .visual-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.85rem;
    border-bottom: 1px solid var(--figure-line);
    background-color: var(--figure-soft);
  }

  .visual-bar-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--type-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .visual-bar-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background-color: var(--figure-accent);
  }

  .visual-bar-meta {
    color: var(--figure-muted);
    font-family: var(--face-mono);
    font-size: var(--type-micro);
  }

  .visual-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1rem;
  }

  .visual-title-row,
  .limit-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .visual-title {
    overflow: hidden;
    color: var(--figure-ink);
    font-size: var(--type-small);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .visual-value {
    color: var(--figure-accent);
    font-size: var(--type-caption);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .segments {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.2rem;
  }

  .segment {
    height: 1.6rem;
    border-radius: 0.2rem;
    background-color: var(--figure-line);
  }

  .segment.is-done {
    background-color: var(--figure-accent);
  }

  .segment.is-live {
    background-color: color-mix(in srgb, var(--figure-accent) 45%, var(--figure-line));
  }

  .visual-meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--figure-muted);
    font-size: var(--type-micro);
    font-variant-numeric: tabular-nums;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .chip {
    padding: 0.28rem 0.5rem;
    border: 1px solid var(--figure-line);
    border-radius: 999px;
    color: var(--figure-muted);
    font-size: var(--type-micro);
    line-height: 1.2;
  }

  .chip.is-lit {
    border-color: color-mix(in srgb, var(--figure-accent) 35%, var(--figure-line));
    color: var(--figure-accent);
  }

  .manifest {
    display: grid;
    border-top: 1px solid var(--figure-line);
  }

  .manifest-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--figure-line);
    font-size: var(--type-caption);
  }

  .manifest-code {
    color: var(--figure-ink);
    font-family: var(--face-mono);
    font-size: var(--type-micro);
    font-variant-numeric: tabular-nums;
  }

  .manifest-state {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--figure-muted);
    font-size: var(--type-micro);
  }

  .manifest-row.is-done .manifest-state,
  .manifest-row.is-receiving .manifest-state {
    color: var(--figure-accent);
  }

  .visual-note {
    color: var(--figure-muted);
    font-size: var(--type-micro);
    line-height: 1.55;
  }

  .protocols {
    display: flex;
    gap: 0.3rem;
  }

  .protocol {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--figure-line);
    border-radius: 0.35rem;
    color: var(--figure-muted);
    font-family: var(--face-mono);
    font-size: var(--type-micro);
  }

  .protocol.is-on {
    border-color: color-mix(in srgb, var(--figure-accent) 35%, var(--figure-line));
    background-color: color-mix(in srgb, var(--figure-accent) 10%, transparent);
    color: var(--figure-accent);
  }

  .code {
    display: grid;
    gap: 0.35rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid var(--figure-line);
    border-radius: 0.35rem;
    background-color: var(--figure-soft);
    font-family: var(--face-mono);
    font-size: var(--type-micro);
    line-height: 1.5;
  }

  .code-line {
    color: var(--figure-ink);
    overflow-wrap: anywhere;
  }

  .code-dim {
    color: var(--figure-muted);
  }

  .response {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--figure-muted);
    font-family: var(--face-mono);
    font-size: var(--type-micro);
  }

  .response-code {
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    background-color: color-mix(in srgb, var(--figure-accent) 12%, transparent);
    color: var(--figure-accent);
  }

  .limit {
    display: grid;
    gap: 0.4rem;
  }

  .limit-head {
    color: var(--figure-ink);
    font-size: var(--type-caption);
  }

  .limit-track {
    height: 0.35rem;
    border-radius: 999px;
    background-color: var(--figure-line);
    overflow: hidden;
  }

  .limit-track span {
    display: block;
    width: var(--value);
    height: 100%;
    border-radius: inherit;
    background-color: var(--figure-accent);
  }

  .menu {
    display: grid;
    padding: 0.3rem;
    border: 1px solid var(--figure-line);
    border-radius: 0.45rem;
    background-color: var(--figure-soft);
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.55rem;
    border-radius: 0.3rem;
    color: var(--figure-ink);
    font-size: var(--type-caption);
    line-height: 1.3;
  }

  .menu-item.is-selected {
    background-color: color-mix(in srgb, var(--figure-accent) 14%, transparent);
    color: var(--figure-accent);
  }

  .menu-item.is-selected :global(svg) {
    margin-left: auto;
  }

  .menu-item img {
    border-radius: 0.2rem;
  }

  .menu-sep {
    height: 1px;
    margin: 0.25rem 0.35rem;
    background-color: var(--figure-line);
  }

  .bridge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--figure-muted);
    font-size: var(--type-micro);
  }

  .bridge-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background-color: var(--figure-accent);
  }

  .tray {
    display: grid;
    gap: 0.55rem;
    padding: 0.8rem;
    border: 1px solid var(--figure-line);
    border-radius: 0.45rem;
    background-color: var(--figure-soft);
  }

  .tray-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .tray-head img {
    border-radius: 0.25rem;
  }

  .tray-name {
    font-size: var(--type-caption);
    font-weight: 500;
  }

  .tray-count {
    margin-left: auto;
    padding: 0.15rem 0.4rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--figure-accent) 12%, transparent);
    color: var(--figure-accent);
    font-size: var(--type-micro);
  }

  .tray-track {
    height: 0.35rem;
    border-radius: 999px;
    background-color: var(--figure-line);
    overflow: hidden;
  }

  .tray-track span {
    display: block;
    width: var(--value);
    height: 100%;
    border-radius: inherit;
    background-color: var(--figure-accent);
  }

  .tray-meta {
    color: var(--figure-muted);
    font-size: var(--type-micro);
    font-variant-numeric: tabular-nums;
  }

  .tray-actions {
    display: flex;
    gap: 0.4rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--figure-line);
  }

  .tray-actions span {
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--figure-line);
    border-radius: 0.3rem;
    color: var(--figure-muted);
    font-size: var(--type-micro);
  }

  .tray-actions span:first-child {
    color: var(--figure-ink);
  }
</style>
