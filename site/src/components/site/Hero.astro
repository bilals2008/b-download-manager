---
import Button from "./Button.astro";
import PlatformIcon from "./PlatformIcon.astro";
import PreviewPlaceholder from "./PreviewPlaceholder.astro";
import { RELEASES_URL } from "../../lib/releases";

const platforms = [
  { name: "windows", label: "Windows" },
  { name: "apple", label: "macOS" },
  { name: "linux", label: "Linux" },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-page">
    <div class="hero-copy">
      <p class="hero-eyebrow">
        <span class="hero-eyebrow-dot" aria-hidden="true"></span>
        Version 0.1.0 · live
      </p>

      <h1 id="hero-title" class="hero-title">
        Pick up where
        <span class="hero-title-line">it stopped<span class="hero-title-dot">.</span></span>
      </h1>

      <p class="hero-lede">
        Splits files across parallel connections and keeps every byte on disk.
        Pause or restart: it continues where it stopped.
      </p>

      <div class="hero-actions">
        <Button
          href={RELEASES_URL}
          variant="primary"
          icon="download"
          data-download
          data-download-label
        >
          Download
        </Button>
        <Button href="#features" variant="secondary" icon="arrow-down">
          See what it does
        </Button>
      </div>

      <ul class="hero-platforms" aria-label="Supported platforms">
        {
          platforms.map((platform) => (
            <li>
              <PlatformIcon name={platform.name} size={15} />
              {platform.label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-figure reveal">
      <PreviewPlaceholder />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.75rem, 6vw, 4.5rem) var(--section-space);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: -4rem 0 auto;
    z-index: -1;
    height: 30rem;
    background: radial-gradient(
      58% 62% at 50% 0%,
      color-mix(in srgb, var(--accent) 9%, transparent),
      transparent 72%
    );
    pointer-events: none;
  }

  .hero-copy {
    max-width: 54rem;
    margin-inline: auto;
    text-align: center;
  }

  .hero-copy > * {
    animation: hero-rise 820ms var(--ease-spring) both;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.7rem 0.35rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: var(--type-caption);
    font-weight: 500;
    line-height: 1.2;
    animation-delay: 40ms;
  }

  .hero-eyebrow-dot {
    width: 0.4rem;
    height: 0.4rem;
    flex: none;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero-title {
    margin-top: 1.4rem;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-hero);
    font-optical-sizing: auto;
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.94;
    text-wrap: balance;
    animation-delay: 120ms;
  }

  .hero-title-line {
    display: block;
    color: var(--accent);
  }

  .hero-title-dot {
    color: var(--ink);
  }

  .hero-lede {
    max-width: 44ch;
    margin: 1.6rem auto 0;
    color: var(--muted);
    font-size: var(--type-lede);
    line-height: 1.55;
    text-wrap: pretty;
    animation-delay: 220ms;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 2rem;
    animation-delay: 320ms;
  }

  .hero-platforms {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 1.4rem;
    margin-top: 1.6rem;
    color: var(--muted);
    font-size: var(--type-caption);
    line-height: 1.4;
    animation-delay: 400ms;
  }

  .hero-platforms li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-actions :global(.btn--primary) {
    min-height: 3.15rem;
    padding-inline: 1.6rem;
    border-radius: var(--radius-sm);
    font-size: var(--type-body);
  }

  .hero-actions :global(.btn--secondary) {
    min-height: 3.15rem;
    padding-inline: 1.35rem;
    border-radius: var(--radius-sm);
  }

  .hero-platforms :global(svg) {
    color: var(--ink-soft);
  }

  .hero-figure {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 40rem) {
    .hero-actions {
      gap: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy > * {
      animation: none;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 16px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
</style>
