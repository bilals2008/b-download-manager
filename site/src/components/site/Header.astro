---
import Button from "./Button.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<div class="nav-shell">
  <header class="nav-pill">
    <a class="brand" href="/" aria-label="B Download Manager home">
      <img
        src="/images/app-icon.png"
        alt=""
        width="30"
        height="30"
        class="brand-mark"
      />
      <span class="brand-name">B Download Manager</span>
    </a>

    <nav class="nav-links" aria-label="Sections">
      <a href="#features">Features</a>
      <a href="#how-it-works">How it works</a>
      <a href="#faq">FAQ</a>
      <a href="/getting-started/">Docs</a>
    </nav>

    <div class="nav-actions">
      <ThemeToggle />
      <Button href="/installation/" variant="nav" icon="download">
        Install
      </Button>
    </div>
  </header>
</div>

<style>
  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-block: 0.75rem;
    pointer-events: none;
  }

  .nav-pill {
    width: calc(100% - (var(--gutter) * 2));
    max-width: var(--container);
    min-height: 3.25rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.35rem 0.4rem 0.35rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--line) 88%, transparent);
    border-radius: 999px;
    background-color: var(--page);
    background-color: color-mix(in srgb, var(--page) 86%, transparent);
    backdrop-filter: blur(16px) saturate(1.15);
    pointer-events: auto;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .brand:hover {
    color: var(--accent);
  }

  .brand-mark {
    width: 1.875rem;
    height: 1.875rem;
    flex: none;
    border-radius: 0.5rem;
  }

  .brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 1.4rem;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: var(--muted);
    font-size: var(--type-label);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--ink);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  @media (min-width: 30rem) {
    .nav-pill {
      padding-inline: 1rem 0.4rem;
    }
  }

  @media (max-width: 29.99rem) {
    .brand-name {
      display: none;
    }
  }

  @media (min-width: 48rem) {
    .nav-pill {
      min-height: 3.5rem;
      gap: 1.75rem;
    }

    .nav-links {
      display: flex;
    }
  }
</style>
