---
import Button from "./Button.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<div class="nav-sentinel" data-nav-sentinel aria-hidden="true"></div>

<header class="nav" data-nav>
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="B Download Manager (Beta) home">
      <img
        src="/images/app-icon.png"
        alt=""
        width="28"
        height="28"
        class="brand-mark"
      />
      <span class="brand-name">B Download Manager</span>
      <span class="beta-badge" aria-hidden="true">Beta</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <a href="#features" data-spy>Features</a>
      <a href="#download" data-spy>Download</a>
      <a href="/getting-started/">Docs</a>
      <a class="nav-github" href="https://github.com/bilals2008/b-download-manager">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          />
        </svg>
        GitHub
      </a>
    </nav>

    <div class="nav-actions">
      <ThemeToggle />
      <Button
        variant="nav"
        icon="download"
        class="nav-install"
      >
        Download
      </Button>

      <details class="nav-menu" data-nav-menu>
        <summary class="nav-menu-toggle" aria-label="Open menu">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </summary>
        <div class="nav-menu-panel">
          <nav class="nav-menu-links" aria-label="Mobile">
            <a href="#features">Features</a>
            <a href="#download">Download</a>
            <a href="/getting-started/">Docs</a>
            <a class="nav-github" href="https://github.com/bilals2008/b-download-manager">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                />
              </svg>
              GitHub
            </a>
          </nav>
          <div class="nav-menu-foot">
            <Button variant="nav" icon="download">
              Download
            </Button>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  .nav.is-scrolled {
    border-bottom-color: var(--line);
    background-color: color-mix(in srgb, var(--page) 88%, transparent);
    backdrop-filter: blur(16px) saturate(1.15);
  }

  .nav-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: var(--container);
    min-height: 4rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .brand:hover {
    color: var(--accent);
  }

  .brand-mark {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border-radius: 0.45rem;
  }

  .brand-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .beta-badge {
    flex: none;
    padding: 0.12rem 0.42rem;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--accent) 9%, transparent);
    color: var(--accent);
    font-family: var(--face-sans);
    font-size: var(--type-micro);
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .nav-links {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  .nav-links a,
  .nav-menu-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding-inline: 0.8rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: var(--type-label);
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .nav-links a:hover,
  .nav-menu-links a:hover {
    background-color: var(--surface);
    color: var(--ink);
  }

  .nav-links a[aria-current="location"] {
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .nav-github svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .nav-menu-links .nav-github {
    justify-content: flex-start;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    justify-self: end;
  }

  .nav-install {
    display: none;
  }

  .nav-menu {
    position: relative;
  }

  .nav-menu-toggle {
    display: grid;
    place-content: center;
    gap: 5px;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .nav-menu-toggle:hover {
    border-color: var(--line-strong);
    background-color: var(--surface);
  }

  .nav-menu-toggle span {
    width: 0.95rem;
    height: 1.5px;
    background-color: currentColor;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .nav-menu[open] .nav-menu-toggle span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  .nav-menu[open] .nav-menu-toggle span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .nav-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    width: min(19rem, calc(100vw - (var(--gutter) * 2)));
    padding: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background-color: var(--page);
    box-shadow: var(--shadow-panel);
  }

  .nav-menu-links {
    display: grid;
  }

  .nav-menu-links a {
    display: flex;
    justify-content: space-between;
    border-radius: var(--radius-xs);
    padding-inline: 0.7rem;
  }

  .nav-menu-foot {
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--line);
  }

  .nav-menu-foot :global(.btn) {
    width: 100%;
    border-radius: var(--radius-xs);
  }

  @media (min-width: 56rem) {
    .nav-inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      min-height: 4.25rem;
    }

    .nav-links,
    .nav-install {
      display: flex;
    }

    .nav-menu {
      display: none;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const sentinel = document.querySelector<HTMLElement>("[data-nav-sentinel]");

  if (nav && sentinel && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(([entry]) => {
      nav.classList.toggle("is-scrolled", !entry.isIntersecting);
    });

    observer.observe(sentinel);
  }

  const menu = document.querySelector<HTMLDetailsElement>("[data-nav-menu]");

  menu?.addEventListener("toggle", () => {
    const toggle = menu.querySelector("summary");
    toggle?.setAttribute("aria-label", menu.open ? "Close menu" : "Open menu");
  });

  menu?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("a")) {
      menu.open = false;
    }
  });

  const spyLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-spy]"),
  );

  const spySections = spyLinks
    .map((link) => {
      const hash = link.getAttribute("href") ?? "";
      return hash.startsWith("#") ? document.querySelector(hash) : null;
    })
    .filter((section): section is Element => section !== null);

  if (spySections.length && "IntersectionObserver" in window) {
    const setActive = (id: string) => {
      for (const link of spyLinks) {
        if (link.getAttribute("href") === `#${id}`) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: "-40% 0px -55% 0px" },
    );

    for (const section of spySections) spy.observe(section);
  }
</script>
