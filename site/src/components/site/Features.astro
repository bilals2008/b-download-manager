---
import Button from "./Button.astro";

type Feature = {
  kicker: string;
  title: string;
  body: string;
  bullets: string[];
  image: string;
  imageAlt: string;
};

const features: Feature[] = [
  {
    kicker: "Segmented transfers",
    title: "One file, up to 32 connections.",
    body: "The engine cuts a file into byte ranges and gives each one its own connection, with a per-site cap and an application-wide budget.",
    bullets: [
      "Up to 32 connections per file",
      "Per-site and global caps",
      "Ranges sized at 16 MiB",
    ],
    image: "/images/features/connections.webp",
    imageAlt:
      "The connections pane: one file at 68 percent, six of its thirty-two connections listed with their byte ranges, downloaded amounts and live speeds.",
  },
  {
    kicker: "Resume",
    title: "Resume, not restart.",
    body: "A crash-safe manifest records every finished range. Pause, close the app or lose power; the next run reads the bytes already on disk.",
    bullets: [
      "Manifest beside the part files",
      "Overlaps and out-of-order ranges rejected",
      "FTP REST offsets for the same job",
    ],
    image: "/images/features/resume.webp",
    imageAlt:
      "A stopped download after a crash: the manifest's finished ranges as green blocks, 237 of 347 megabytes kept, and the next range to fetch.",
  },
  {
    kicker: "HTTP, HTTPS and FTP",
    title: "Range requests where they work.",
    body: "HTTP and HTTPS ask for identity-encoded ranges. FTP seeks with REST. A server that answers with a plain 200 is fetched on one connection.",
    bullets: [
      "Range-first requests",
      "FTP data connection per range",
      "One-connection fallback",
    ],
    image: "/images/features/probe.webp",
    imageAlt:
      "The Add URL window probing an FTP link: probed size, ranges accepted, protocol, and the category folder the file will land in.",
  },
  {
    kicker: "Limits",
    title: "A ceiling you choose.",
    body: "Set one cap for the whole application and one for each download, in KB/s or MB/s. The engine applies the limit across every open connection.",
    bullets: [
      "Global and per-download caps",
      "KB/s or MB/s",
      "Applied per connection",
    ],
    image: "/images/features/limits.webp",
    imageAlt:
      "The speed limiter: a 4 MB/s cap for this download and 12 MB/s for the whole application, with six connections sharing 9.6 MB/s right now.",
  },
];
---

<section id="features" class="section features" aria-labelledby="features-title">
  <div class="container-page">
    <header class="features-head reveal">
      <p class="eyebrow">What it does</p>
      <h2 id="features-title" class="section-title">
        The hard part is finishing.
      </h2>
      <p class="section-copy">
        No account, no cloud, no editor you did not ask for. A focused engine
        and a Windows-style queue that stays out of the way.
      </p>
    </header>

    <div class="feature-stack">
      {
        features.map((feature, index) => (
          <article
            class:list={["feature-row", index % 2 === 1 && "feature-row--reverse", "reveal"]}
          >
            <div class="feature-copy">
              <p class="feature-kicker">{feature.kicker}</p>
              <h3 class="feature-title">{feature.title}</h3>
              <p class="feature-body">{feature.body}</p>
              <ul class="feature-bullets">
                {feature.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>

            <div class="feature-visual">
              <img
                src={feature.image}
                width="1344"
                height="864"
                alt={feature.imageAlt}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
          </article>
        ))
      }
    </div>

    <div class="features-more reveal">
      <Button href="/features/" variant="secondary" icon="arrow-right">
        See more features
      </Button>
    </div>
  </div>
</section>

<style>
  .features-head {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .features-head :global(.section-title),
  .features-head :global(.section-copy) {
    margin-inline: auto;
  }

  .feature-stack {
    display: grid;
    gap: clamp(3.5rem, 7vw, 6rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .feature-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    align-items: center;
  }

  .feature-kicker {
    color: var(--muted);
    font-size: var(--type-caption);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .feature-title {
    margin-top: 0.8rem;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-subsection);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .feature-body {
    max-width: 48ch;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: 1.65;
  }

  .feature-bullets {
    display: grid;
    gap: 0.5rem;
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .feature-bullets li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--ink);
    font-size: var(--type-small);
    line-height: 1.5;
  }

  .feature-bullets li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .feature-visual {
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--figure-bg);
    box-shadow: var(--shadow-panel);
  }

  .feature-visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  .features-more {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
  }

  @media (min-width: 56rem) {
    .feature-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(3rem, 6vw, 5.5rem);
    }

    .feature-row--reverse .feature-copy {
      grid-column: 2;
      grid-row: 1;
    }

    .feature-row--reverse .feature-visual {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>