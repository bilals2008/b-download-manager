---
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";
import PreviewPlaceholder from "./PreviewPlaceholder.astro";

type Feature = {
  icon: IconName;
  kicker: string;
  title: string;
  body: string;
  bullets: string[];
};

const features: Feature[] = [
  {
    icon: "network",
    kicker: "Segmented transfers",
    title: "One file, up to 32 connections.",
    body: "The engine cuts a file into byte ranges and gives each one its own connection, with a per-site cap and an application-wide budget.",
    bullets: [
      "Up to 32 connections per file",
      "Per-site and global caps",
      "Ranges sized at 16 MiB",
    ],
  },
  {
    icon: "resume",
    kicker: "Resume",
    title: "Resume, not restart.",
    body: "A crash-safe manifest records every finished range. Pause, close the app or lose power; the next run reads the bytes already on disk.",
    bullets: [
      "Manifest beside the part files",
      "Overlaps and out-of-order ranges rejected",
      "FTP REST offsets for the same job",
    ],
  },
  {
    icon: "globe",
    kicker: "HTTP, HTTPS and FTP",
    title: "Range requests where they work.",
    body: "HTTP and HTTPS ask for identity-encoded ranges. FTP seeks with REST. A server that answers with a plain 200 is fetched on one connection.",
    bullets: [
      "Range-first requests",
      "FTP data connection per range",
      "One-connection fallback",
    ],
  },
  {
    icon: "gauge",
    kicker: "Limits",
    title: "A ceiling you choose.",
    body: "Set one cap for the whole application and one for each download, in KB/s or MB/s. The engine applies the limit across every open connection.",
    bullets: [
      "Global and per-download caps",
      "KB/s or MB/s",
      "Applied per connection",
    ],
  },
  {
    icon: "browser",
    kicker: "Browser hand-off",
    title: "Send links from the browser.",
    body: "Firefox, Chrome and Edge extensions pass a link to the app over a versioned loopback bridge. No native messaging host and no registry entry.",
    bullets: [
      "Right-click hand-off",
      "Firefox video button",
      "Chrome and Edge build",
    ],
  },
  {
    icon: "tray",
    kicker: "Tray",
    title: "Close the window, keep the queue.",
    body: "The tray restores the window, starts or stops the queue, and is the way out. Closing the window hides it; nothing stops downloading.",
    bullets: [
      "Queue keeps running",
      "Start and stop from the tray",
      "Quit from the tray",
    ],
  },
];
---

<section id="features" class="section features" aria-labelledby="features-title">
  <div class="container-page">
    <header class="features-head reveal">
      <p class="eyebrow">What it does</p>
      <h2 id="features-title" class="section-title">
        The hard part is finishing.
      </h2>
      <p class="section-copy">
        No account, no cloud, no editor you did not ask for. A focused engine
        and a Windows-style queue that stays out of the way.
      </p>
    </header>

    <div class="feature-stack">
      <span class="feature-spine" aria-hidden="true"></span>

      {
        features.map((feature, index) => (
          <article
            class:list={[
              "feature-row",
              index % 2 === 1 && "feature-row--reverse",
              "reveal",
            ]}
          >
            <span class="feature-index" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>

            <div class="feature-copy">
              <div class="feature-kicker">
                <span class="feature-icon">
                  <Icon name={feature.icon} size={17} />
                </span>
                <span>{feature.kicker}</span>
              </div>
              <h3 class="feature-title">{feature.title}</h3>
              <p class="feature-body">{feature.body}</p>
              <ul class="feature-bullets">
                {feature.bullets.map((bullet) => (
                  <li>
                    <span class="feature-check">
                      <Icon name="check" size={11} strokeWidth={2} />
                    </span>
                    {bullet}
                  </li>
                ))}
              </ul>
            </div>

            <div class="feature-visual">
              <PreviewPlaceholder />
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features-head {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .features-head :global(.section-title),
  .features-head :global(.section-copy) {
    margin-inline: auto;
  }

  .feature-stack {
    position: relative;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .feature-spine {
    display: none;
  }

  .feature-row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }

  .feature-row:first-of-type {
    padding-top: 0;
    border-top: 0;
  }

  .feature-row + .feature-row {
    margin-top: 3rem;
  }

  .feature-index {
    display: inline-flex;
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--face-mono);
    font-size: var(--type-caption);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .feature-copy {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .feature-kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted);
    font-size: var(--type-caption);
    font-weight: 500;
    line-height: 1.3;
  }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .feature-title {
    margin-top: 0.95rem;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-subsection);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .feature-body {
    max-width: 48ch;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: 1.65;
  }

  .feature-bullets {
    display: grid;
    gap: 0.55rem;
    margin-top: 1.4rem;
  }

  .feature-bullets li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    font-size: var(--type-small);
    line-height: 1.45;
  }

  .feature-check {
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
    border-radius: 50%;
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .feature-visual {
    grid-column: 1 / -1;
    grid-row: 2;
    width: 100%;
    max-width: 30rem;
    justify-self: center;
  }

  .feature-visual :global(.preview-placeholder) {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 56rem) {
    .feature-stack {
      display: grid;
      gap: clamp(4rem, 8vw, 7rem);
    }

    .feature-spine {
      display: block;
      position: absolute;
      top: 1.2rem;
      bottom: 1.2rem;
      left: 50%;
      width: 1px;
      background: linear-gradient(
        to bottom,
        transparent,
        var(--line) 8%,
        var(--line) 92%,
        transparent
      );
      transform: translateX(-50%);
    }

    .feature-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(3rem, 7vw, 6rem);
      padding-top: 0;
      padding-block: 0;
      border-top: 0;
    }

    .feature-row + .feature-row {
      margin-top: 0;
    }

    .feature-copy {
      grid-column: 1;
      grid-row: 1;
    }

    .feature-visual {
      grid-column: 2;
      grid-row: 1;
    }

    .feature-row--reverse .feature-copy {
      grid-column: 2;
      grid-row: 1;
    }

    .feature-row--reverse .feature-visual {
      grid-column: 1;
      grid-row: 1;
    }

    .feature-index {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      width: 2.75rem;
      height: 2.75rem;
      background-color: var(--page);
      transform: translate(-50%, -50%);
    }
  }
</style>
