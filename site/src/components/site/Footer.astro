---
import Icon from "./Icon.astro";

const links = [
  { href: "#features", label: "Features" },
  { href: "#download", label: "Download" },
  { href: "#faq", label: "FAQ" },
  { href: "/getting-started/", label: "Documentation" },
];

const socials = [
  { href: "https://github.com/bilals2008", label: "GitHub", icon: "github" },
  {
    href: "https://www.linkedin.com/in/muhammad-bilal-hassan-327209414/",
    label: "LinkedIn",
    icon: "linkedin",
  },
  { href: "https://x.com/MBilal7555", label: "X", icon: "x-social" },
  {
    href: "https://discord.com/users/1263166539058647140",
    label: "Discord",
    icon: "discord",
  },
  { href: "mailto:bilaldev7575@gmail.com", label: "Email", icon: "mail" },
] as const;
---

<footer class="site-footer">
  <div class="container-page">
    <div class="footer-main">
      <a class="footer-brand" href="/" aria-label="B Download Manager home">
        <img
          src="/images/app-icon.png"
          alt=""
          width="28"
          height="28"
          class="footer-mark"
        />
        <span>B Download Manager</span>
      </a>

      <nav class="footer-links" aria-label="Footer">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>

      <a class="footer-top" href="#top">
        Back to top
        <Icon name="arrow-up" size={14} />
      </a>
    </div>

    <div class="footer-base">
      <p>
        Built by <a
          href="https://mbilalhassan.vercel.app/"
          target="_blank"
          rel="noreferrer">Muhammad Bilal Hassan</a
        >
      </p>

      <nav class="footer-socials" aria-label="Social">
        {
          socials.map((social) => (
            <a
              href={social.href}
              aria-label={social.label}
              target={social.href.startsWith("mailto:") ? undefined : "_blank"}
              rel="noreferrer"
            >
              <Icon name={social.icon} size={17} />
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--footer-bg);
    color: var(--footer-ink);
  }

  .footer-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block: 1.75rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--footer-ink);
    font-family: var(--face-display);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-decoration: none;
  }

  .footer-brand:hover {
    color: var(--footer-accent);
  }

  .footer-mark {
    border-radius: 0.4rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 1.2rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: var(--footer-muted);
    font-size: var(--type-small);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--footer-ink);
  }

  .footer-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--footer-line);
    border-radius: 999px;
    color: var(--footer-ink);
    font-size: var(--type-caption);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .footer-top:hover {
    border-color: var(--footer-accent);
    color: var(--footer-accent);
  }

  .footer-top :global(svg) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .footer-top:hover :global(svg) {
    transform: translateY(-2px);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 2rem;
    padding-block: 1rem;
    border-top: 1px solid var(--footer-line);
    color: var(--footer-muted);
    font-size: var(--type-caption);
    line-height: 1.5;
  }

  .footer-base a {
    color: var(--footer-ink);
    text-underline-offset: 0.2em;
    text-decoration-color: var(--footer-line);
  }

  .footer-base a:hover {
    color: var(--footer-accent);
    text-decoration-color: currentColor;
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin-inline-end: -0.5rem;
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-xs);
    color: var(--footer-muted);
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .footer-socials a:hover {
    background-color: color-mix(in srgb, var(--footer-ink) 6%, transparent);
    color: var(--footer-ink);
  }

  .site-footer :focus-visible {
    outline-color: var(--footer-accent);
  }

  @media (min-width: 48rem) {
    .footer-main {
      padding-block: 2rem;
    }
  }
</style>
