---
import Icon from "./Icon.astro";

const productLinks = [
  { href: "#features", label: "Features" },
  { href: "#how-it-works", label: "How it works" },
  { href: "#faq", label: "FAQ" },
];

const docsLinks = [
  { href: "/getting-started/", label: "Getting started" },
  { href: "/installation/", label: "Installation" },
  { href: "/troubleshooting/", label: "Troubleshooting" },
];
---

<footer class="site-footer">
  <div class="container-page">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="footer-logo" href="/" aria-label="B Download Manager home">
          <img
            src="/images/app-icon.png"
            alt=""
            width="32"
            height="32"
            class="footer-mark"
          />
          <span>B Download Manager</span>
        </a>
        <p class="footer-copy">
          A multi-connection desktop download manager for HTTP, HTTPS and FTP.
          Version 0.1.0 preview.
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <div>
          <h2 class="footer-heading">Product</h2>
          <ul>
            {
              productLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 class="footer-heading">Documentation</h2>
          <ul>
            {
              docsLinks.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer-base">
      <p>
        Built by <a
          href="https://mbilalhassan.vercel.app/"
          target="_blank"
          rel="noreferrer">Muhammad Bilal Hassan</a
        >
      </p>
      <a class="footer-top" href="#top">
        Back to top
        <Icon name="arrow-up" size={14} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--footer-bg);
    color: var(--footer-ink);
  }

  .footer-grid {
    display: grid;
    gap: 2.75rem;
    padding-block: clamp(3rem, 6vw, 5rem) 3rem;
  }

  .footer-brand {
    max-width: 22rem;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--footer-ink);
    font-family: var(--face-display);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-decoration: none;
  }

  .footer-logo:hover {
    color: var(--footer-accent);
  }

  .footer-mark {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
  }

  .footer-copy {
    margin-top: 1rem;
    color: var(--footer-muted);
    font-size: var(--type-small);
    line-height: 1.7;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer-heading {
    color: var(--footer-muted);
    font-family: var(--face-sans);
    font-size: var(--type-micro);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .footer-nav ul {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.1rem;
  }

  .footer-nav a {
    color: var(--footer-ink);
    font-size: var(--type-small);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .footer-nav a:hover {
    color: var(--footer-accent);
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--footer-line);
    color: var(--footer-muted);
    font-size: var(--type-caption);
  }

  .footer-base a {
    color: var(--footer-ink);
    min-height: 1.5rem;
    display: inline-flex;
    align-items: center;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--footer-line);
  }

  .site-footer :focus-visible {
    outline-color: var(--footer-accent);
  }

  .footer-base a:hover {
    color: var(--footer-accent);
    text-decoration-color: currentColor;
  }

  .footer-top {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
  }

  .footer-top :global(svg) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .footer-top:hover :global(svg) {
    transform: translateY(-2px);
  }

  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4rem;
    }

    .footer-nav {
      gap: 4rem;
    }
  }
</style>
