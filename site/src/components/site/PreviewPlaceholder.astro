---
import Icon from "./Icon.astro";

interface Props {
  class?: string;
  /** Screenshot to show instead of the empty placeholder mark. */
  src?: string;
  alt?: string;
}

const { class: className, src, alt = "" } = Astro.props;
---

{
  src ? (
    <div class:list={["preview-shot", className]}>
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class:list={["preview-placeholder", className]} aria-hidden="true">
      <span class="preview-placeholder-mark">
        <Icon name="image" size={22} />
      </span>
    </div>
  )
}

<style>
  .preview-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 70rem;
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    border: 1px solid var(--figure-border);
    border-radius: var(--radius-md);
    background-color: var(--figure-bg);
  }

  .preview-placeholder-mark {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--figure-line);
    border-radius: 0.8rem;
    background-color: var(--figure-soft);
    color: var(--figure-muted);
  }

  .preview-shot {
    width: 100%;
    max-width: 70rem;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid var(--figure-border);
    background-color: var(--figure-bg);
  }

  .preview-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 56rem) {
    .preview-placeholder {
      border-radius: var(--radius-lg);
    }
  }
</style>
