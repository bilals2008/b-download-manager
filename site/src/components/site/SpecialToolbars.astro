---
import Icon from "./Icon.astro";

/** The looks the desktop app ships today. */
const styles = [
  "Default",
  "3D Style",
  "Classic",
  "Isometric",
  "Blueprint",
] as const;
---

<section id="toolbars" class="toolbars" aria-labelledby="toolbars-title">
  <div class="container-page toolbars-grid">
    <div class="toolbars-intro reveal">
      <p class="eyebrow">Toolbar packs</p>
      <h2 id="toolbars-title" class="toolbars-title">
        Special toolbars, coming soon.
      </h2>
      <p class="toolbars-copy">
        Five original looks already ship with the app, and any toolbar pack can
        be installed from a JSON file. A shelf of special toolbars is being
        drawn next.
      </p>
    </div>

    <div class="toolbars-list-wrap reveal">
      <p class="toolbars-list-label">Built in today</p>
      <ul class="toolbars-list">
        {
          styles.map((name) => (
            <li class="toolbars-row">
              <span class="toolbars-check">
                <Icon name="check" size={12} strokeWidth={2} />
              </span>
              <span>{name}</span>
            </li>
          ))
        }
        <li class="toolbars-row toolbars-row--upcoming">
          <span class="toolbars-check">
            <Icon name="star" size={12} strokeWidth={1.6} />
          </span>
          <span>Special toolbars</span>
          <span class="toolbars-status">Coming soon</span>
        </li>
      </ul>
      <p class="toolbars-note">
        Switch styles, size and labels in Settings &gt; Toolbar.
      </p>
    </div>
  </div>
</section>

<style>
  .toolbars {
    padding-block: var(--section-space);
  }

  .toolbars-grid {
    display: grid;
    gap: 2.5rem;
  }

  .toolbars-intro {
    max-width: 38rem;
  }

  .toolbars-title {
    margin-top: 1rem;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-section);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .toolbars-copy {
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: 1.65;
  }

  .toolbars-list-label {
    color: var(--muted);
    font-size: var(--type-micro);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .toolbars-list {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .toolbars-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    color: var(--ink);
    font-size: var(--type-small);
    font-weight: 500;
  }

  .toolbars-row--upcoming {
    color: var(--muted);
    border-style: dashed;
    background-color: transparent;
  }

  .toolbars-check {
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    flex: none;
    border-radius: 50%;
    background-color: var(--accent-soft);
    color: var(--accent);
  }

  .toolbars-row--upcoming .toolbars-check {
    border: 1px solid var(--line-strong);
    background-color: transparent;
    color: var(--muted);
  }

  .toolbars-status {
    margin-left: auto;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--muted);
    font-size: var(--type-micro);
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .toolbars-note {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: var(--type-caption);
    line-height: 1.5;
  }

  @media (min-width: 56rem) {
    .toolbars-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: clamp(3rem, 7vw, 6rem);
    }

    .toolbars-intro {
      max-width: 34rem;
    }
  }
</style>
