---
import Button from "./Button.astro";
import PlatformIcon from "./PlatformIcon.astro";
import { RELEASES_URL } from "../../lib/releases";

const platforms = [
  {
    id: "windows",
    name: "Windows 10 and 11",
    meta: "WebView2 runtime",
    status: "Installer",
    tuned: true,
  },
  {
    id: "apple",
    name: "macOS 11 or later",
    meta: "Apple silicon · Intel",
    status: "Universal dmg",
    tuned: true,
  },
  {
    id: "linux",
    name: "Major distributions",
    meta: "AppImage · deb",
    status: "AppImage or deb",
    tuned: true,
  },
] as const;
---

<section id="download" class="section download" aria-labelledby="download-title">
  <div class="container-page">
    <div class="download-band reveal">
      <p class="eyebrow">Get the app</p>
      <h2 id="download-title" class="download-title">
        Install it, or build it.
      </h2>
      <p class="download-copy">
        Version 0.1.0 ships a Windows installer, Linux AppImage and deb
        packages, and a universal macOS dmg, all published on GitHub Releases.
      </p>
      <div class="download-action">
        <Button
          href={RELEASES_URL}
          variant="primary"
          icon="download"
          data-download
          data-download-label
        >
          Download
        </Button>
      </div>
      <p class="download-meta">
        Windows, macOS and Linux · no account · no telemetry
      </p>
    </div>

    <p class="requirements-label">Platforms and what they need</p>

    <ul class="requirements" aria-label="Platform requirements">
      {
        platforms.map((platform) => (
          <li class="requirement">
            <span class="requirement-mark">
              <PlatformIcon name={platform.id} size={18} />
            </span>

            <span class="requirement-name">
              {platform.name}
              <span class="requirement-meta">{platform.meta}</span>
            </span>

            <span
              class:list={[
                "requirement-status",
                platform.tuned && "requirement-status--tuned",
              ]}
            >
              {platform.status}
            </span>

            <a class="requirement-link" href="/installation/">
              Steps
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .download-band {
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.25rem, 5vw, 4rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    text-align: center;
  }

  .download-title {
    margin-top: 1rem;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-section);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .download-copy {
    max-width: 46ch;
    margin: 1.25rem auto 0;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: 1.65;
  }

  .download-action {
    display: flex;
    justify-content: center;
    margin-top: 1.9rem;
  }

  .download-action :global(.btn) {
    min-height: 3.1rem;
    padding-inline: 1.6rem;
    border-radius: var(--radius-sm);
    font-size: var(--type-body);
  }

  .download-meta {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: var(--type-caption);
    line-height: 1.5;
  }

  .requirements {
    margin-top: 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .requirements-label {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    color: var(--muted);
    font-size: var(--type-micro);
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .requirement {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      "mark name status"
      "mark link link";
    align-items: center;
    gap: 0.35rem 0.9rem;
    padding: 1rem 1.1rem;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .requirement + .requirement {
    border-top: 1px solid var(--line);
  }

  .requirement:hover {
    background-color: var(--surface);
  }

  .requirement-mark {
    grid-area: mark;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background-color: var(--surface);
    color: var(--ink);
  }

  .requirement:hover .requirement-mark {
    background-color: var(--page);
  }

  .requirement-name {
    grid-area: name;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.6rem;
    color: var(--ink);
    font-size: var(--type-small);
    font-weight: 500;
    line-height: 1.35;
  }

  .requirement-meta {
    color: var(--muted);
    font-family: var(--face-mono);
    font-size: var(--type-micro);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .requirement-status {
    grid-area: status;
    color: var(--muted);
    font-size: var(--type-caption);
    line-height: 1.3;
    text-align: right;
  }

  .requirement-status--tuned {
    color: var(--accent);
    font-weight: 600;
  }

  .requirement-link {
    grid-area: link;
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-height: 2rem;
    padding-inline: 0.15rem;
    color: var(--accent);
    font-size: var(--type-caption);
    font-weight: 500;
    text-underline-offset: 0.25em;
  }

  .requirement-link:hover {
    color: var(--ink);
  }

  @media (min-width: 48rem) {
    .requirement {
      grid-template-columns: auto minmax(0, 1fr) auto auto;
      grid-template-areas: "mark name status link";
      gap: 1rem;
      padding: 1.1rem 1.35rem;
    }

    .requirement-link {
      justify-self: end;
    }
  }
</style>
