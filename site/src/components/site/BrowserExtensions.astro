---
import Icon from "./Icon.astro";
import { FIREFOX_ADDON_URL } from "../../lib/releases";

const browsers = [
  {
    name: "Firefox",
    logo: "/icons/browsers/firefox.svg",
    href: FIREFOX_ADDON_URL,
  },
  {
    name: "Chrome",
    logo: "/icons/browsers/chrome.svg",
  },
  {
    name: "Edge",
    logo: "/icons/browsers/edge.svg",
  },
  {
    name: "Brave",
    logo: "/icons/browsers/brave.svg",
  },
] as const;
---

<section id="extensions" class="extensions" aria-labelledby="extensions-title">
  <div class="container-page">
    <div class="extensions-head">
      <p class="eyebrow">Browser extension</p>
      <h2 id="extensions-title" class="extensions-title">
        Hand off links from your browser.
      </h2>
      <p class="extensions-copy">
        The Firefox extension is available now. Send a link, a picture or a
        video from any page, and the app picks it up on the same computer.
        Chrome, Edge and Brave are on the way.
      </p>
    </div>

    <ul class="browser-list" aria-label="Browser extensions">
      {
        browsers.map((browser) => (
          <li class="browser">
            <img
              src={browser.logo}
              width="22"
              height="22"
              alt=""
              loading="lazy"
            />
            <span class="browser-name">{browser.name}</span>
            {browser.href ? (
              <a
                class="browser-link"
                href={browser.href}
                target="_blank"
                rel="noreferrer"
              >
                Add to Firefox
                <Icon name="arrow-up-right" size={13} />
              </a>
            ) : (
              <span class="browser-status">Coming soon</span>
            )}
          </li>
        ))
      }
    </ul>

    <p class="extensions-note">
      The extension talks to the app only on this computer. There is no account
      and no code to copy.
    </p>
  </div>
</section>

<style>
  .extensions {
    padding-block: var(--section-space);
  }

  .extensions-head {
    max-width: 40rem;
  }

  .extensions-title {
    margin-top: 1rem;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-section);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .extensions-copy {
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: 1.65;
  }

  .browser-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .browser {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background-color: var(--surface);
  }

  .browser img {
    flex: none;
    display: block;
  }

  .browser-name {
    flex: 1;
    color: var(--ink);
    font-size: var(--type-small);
    font-weight: 500;
  }

  .browser-status {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--muted);
    font-size: var(--type-micro);
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .browser-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    font-size: var(--type-micro);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .browser-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .extensions-note {
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: var(--type-caption);
    line-height: 1.6;
  }

  @media (min-width: 40rem) {
    .browser-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
