---
import DefaultTableOfContents from "@astrojs/starlight/components/TableOfContents.astro";
---

<DefaultTableOfContents />

<nav class="doc-social" aria-label="Elsewhere">
  <p class="doc-social-title">Elsewhere</p>
  <div class="doc-social-links">
    <a
      class="doc-social-link"
      href="https://github.com/bilals2008"
      target="_blank"
      rel="noreferrer"
    >
      <span class="sr-only">Muhammad Bilal Hassan on GitHub</span>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"
          fill="currentColor"></path>
      </svg>
    </a>

    <a
      class="doc-social-link"
      href="https://github.com/bilals2008/b-download-manager/issues/new"
      target="_blank"
      rel="noreferrer"
    >
      <span class="sr-only">Report a problem</span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="m8 2 1.88 1.88"></path>
        <path d="M14.12 3.88 16 2"></path>
        <path d="M9 7.13v-1a3 3 0 1 1 6 0v1"></path>
        <path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"></path>
        <path d="M12 20v-9"></path>
        <path d="M6.53 9C4.6 8.8 3 7.1 3 5"></path>
        <path d="M6 13H2"></path>
        <path d="M3 21c0-2.1 1.7-3.9 3.8-4"></path>
        <path d="M20.97 5c0 2.1-1.6 3.8-3.5 4"></path>
        <path d="M22 13h-4"></path>
        <path d="M17.2 17c2.1.1 3.8 1.9 3.8 4"></path>
      </svg>
    </a>

    <a
      class="doc-social-link"
      href="/rss.xml"
      target="_blank"
      rel="noreferrer"
    >
      <span class="sr-only">RSS feed</span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 11a9 9 0 0 1 9 9"></path>
        <path d="M4 4a16 16 0 0 1 16 16"></path>
        <circle cx="5" cy="19" r="1"></circle>
      </svg>
    </a>

    <a
      class="doc-social-link doc-social-link--author"
      href="https://mbilalhassan.vercel.app/"
      target="_blank"
      rel="noreferrer"
    >
      <span class="sr-only">Muhammad Bilal Hassan's website</span>
      <img src="/images/author.png" alt="" width="32" height="32" loading="lazy" />
    </a>
  </div>
</nav>

<style>
  .doc-social {
    margin-top: 1.75rem;
    border-top: 1px solid var(--sl-color-hairline);
    padding-top: 1rem;
  }

  .doc-social-title {
    margin: 0 0 0.55rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .doc-social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .doc-social-link {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background-color: var(--sl-color-gray-7);
    color: var(--sl-color-gray-1);
    transition:
      color var(--duration-fast, 160ms) var(--ease-out, ease-out),
      border-color var(--duration-fast, 160ms) var(--ease-out, ease-out),
      background-color var(--duration-fast, 160ms) var(--ease-out, ease-out);
  }

  .doc-social-link svg {
    width: 1rem;
    height: 1rem;
  }

  .doc-social-link--author {
    padding: 0;
    overflow: hidden;
  }

  .doc-social-link--author img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .doc-social-link:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-text-accent);
  }

  .doc-social-link--author:hover {
    border-color: var(--sl-color-accent);
  }

  .doc-social-link:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
</style>
