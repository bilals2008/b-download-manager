---
import "../styles/global.css";
import Header from "../components/site/Header.astro";
import Footer from "../components/site/Footer.astro";
import { latestRelease } from "../lib/releases";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// One GitHub read per build. The version and the file list are baked into the
// page, so a click downloads straight away with no runtime API call.
const release = await latestRelease();
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f6f4f1" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/png" href="/images/app-icon.png" />
    <link rel="apple-touch-icon" href="/images/app-icon.png" />
    <link
      rel="preload"
      href="/fonts/bricolage-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <script is:inline>
      (() => {
        let theme = "light";

        try {
          const stored =
            localStorage.getItem("bdm-theme") ||
            localStorage.getItem("starlight-theme");
          if (stored === "light" || stored === "dark") {
            theme = stored;
          } else {
            theme = window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
          }
        } catch {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;

        const themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) {
          themeColor.setAttribute(
            "content",
            getComputedStyle(document.documentElement)
              .getPropertyValue("--page")
              .trim(),
          );
        }

        if (
          "IntersectionObserver" in window &&
          !window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          document.documentElement.classList.add("js-reveal");

          // Never leave the page hidden if the motion bundle fails to run.
          setTimeout(() => {
            if (!document.documentElement.classList.contains("is-motion-ready")) {
              document.documentElement.classList.remove("js-reveal");
            }
          }, 2500);
        }
      })();
    </script>
  </head>

  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <Header version={release?.version ?? ""} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script
      type="application/json"
      id="release-assets"
      set:html={JSON.stringify(release?.assets ?? [])}
    />

    <script>
      import "../scripts/motion";
    </script>

    <script>
      import { detectPlatform, pickAsset, platformNames } from "../lib/releases";

      const platform = detectPlatform();
      const data = document.getElementById("release-assets");
      const assets = data?.textContent ? JSON.parse(data.textContent) : [];
      const asset =
        platform === "other" ? undefined : pickAsset(assets, platform);

      if (platform !== "other" && asset) {
        // The CSS reveals only the mark that matches this attribute.
        document.documentElement.dataset.platform = platform;

        for (const link of document.querySelectorAll<HTMLAnchorElement>(
          "[data-download]",
        )) {
          link.href = asset.url;
        }

        for (const button of document.querySelectorAll<HTMLElement>(
          "[data-download-label]",
        )) {
          const label = button.querySelector("[data-download-text]");
          if (label) {
            label.textContent = `Download for ${platformNames[platform]}`;
          }
        }
      }
    </script>
  </body>
</html>
