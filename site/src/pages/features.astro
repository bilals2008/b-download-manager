---
import LandingLayout from "../layouts/LandingLayout.astro";
import Button from "../components/site/Button.astro";
import ToolbarFeature from "../components/site/ToolbarFeature.astro";
import { RELEASES_URL } from "../lib/releases";

const features: {
  id: string;
  wide?: boolean;
  title: string;
  copy: string;
  points: string[];
  alt: string;
}[] = [
  {
    id: "torrents",
    title: "Magnet links and .torrent files, like any other download.",
    copy: "Add a torrent from a link, a file or an address, then pick exactly which files inside it you want before anything starts.",
    points: [
      "Progress, speed and peers in the torrent window",
      "Finished torrents keep sharing until your ratio or time limit",
      "Upload capped so sharing never crowds your browsing",
    ],
    alt: "The torrent window: a file list with checkboxes, the Ubuntu ISO at 62 percent, skipped extras, and a Keep sharing toggle with a ratio limit.",
  },
  {
    id: "scheduler",
    title: "The queue runs on your hours.",
    copy: "Tell the queue which days and hours it runs. It starts and stops by itself, and powers the computer off only when you say so.",
    points: [
      "Weekdays, weekends or every day, with a from and to time",
      "Power off only when the queue is empty, never mid-download",
      "The next runs listed before they happen",
    ],
    alt: "The queue schedule pane: weekdays selected, hours from 09:00 to 18:00, a power-off toggle, and the next runs listed.",
  },
  {
    id: "captions",
    title: "Videos come with captions.",
    copy: "Pick the captions a page offers, or save just the sound of a video as MP3, Opus or FLAC.",
    points: [
      "Every caption language the page offers, ticked individually",
      "Sound-only saves keep the tags and the cover",
      "Captions land beside the video under the same name",
    ],
    alt: "A video download pane: English and French captions ticked, Arabic left off, and the sound format set to MP3 with a sound-only toggle.",
  },
  {
    id: "drive",
    title: "Google Drive in one click.",
    copy: "Drive files download as files, documents leave as PDF or Word, and image boards arrive as a folder of pictures.",
    points: [
      "Pick a single file or a whole folder",
      "Documents convert on the way down",
      "Boards keep every picture, named and ordered",
    ],
    alt: "The Google Drive pane: documents saving as Word and PDF, a video as a plain file, and an image board as a folder of 24 pictures.",
  },
  {
    id: "language",
    title: "Your words, your language.",
    copy: "The window reads in English, French, German and Arabic, and Arabic reads right to left.",
    points: [
      "Menus, dates and numbers follow the same language",
      "Switch any time in Settings, Appearance",
      "The layout mirrors, it never squeezes",
    ],
    alt: "The Appearance pane with Arabic selected and a right-to-left preview of the download list, counts on the left and the meter row mirrored.",
  },
  {
    id: "network",
    title: "A smarter network.",
    copy: "Look names up through an encrypted resolver or NextDNS, hold downloads to one network adapter, and see every transfer's server and round trip.",
    points: [
      "Encrypted DNS, NextDNS or the system resolver",
      "Bind downloads to Wi-Fi or Ethernet, per adapter",
      "Server and ping shown live on each transfer",
    ],
    alt: "The Network pane: NextDNS selected with a resolver address, downloads bound to the Wi-Fi adapter, and live transfers with their round trips.",
  },
  {
    id: "debrid",
    title: "Host links, unlocked.",
    copy: "Real-Debrid, AllDebrid and Premiumize take the host links they support and download them at your account's speed.",
    points: [
      "Connect once; supported links unlock themselves",
      "Free-tier waits and speed caps disappear",
      "Queued links wait their turn instead of failing",
    ],
    alt: "The host accounts pane: Real-Debrid and AllDebrid connected, Premiumize not, and a Rapidgator link downloading at 12.4 megabytes per second.",
  },
  {
    id: "addurl",
    title: "Small stuff that adds up.",
    copy: "Add URL starts straight away, and archives unpack when they finish, asking for a password only when one is needed.",
    points: [
      "No second confirm after Add",
      "Unpacks into the category's own folder",
      "A frozen window is reported on the next start",
    ],
    alt: "The Add URL window: a link filled in, start-straight-away and unpack toggles on, and an archive password field in dots.",
  },
  {
    id: "themes",
    wide: true,
    title: "Ten appearances, one identity.",
    copy: "Light, Bloom, Dark, Cyberpunk, Volt, Soft Black, Ayu Dark, Graphite and Hive — or Auto, following the system. Picking one repaints every window at once, tray and browser panel included.",
    points: [
      "A colour swatch for every theme on the Appearance page",
      "Bloom carries the light side: warm paper, honey only where it means something",
      "Auto follows the operating system until you override it",
    ],
    alt: "The Appearance pane drawn in the Bloom light theme: a swatch grid of all ten themes with Bloom selected, beside a live preview of three downloads in Bloom's colours.",
  },
];
---

<LandingLayout
  title="Features · B Download Manager"
  description="Toolbar packs, torrents, a queue schedule, captions and audio, Google Drive, four languages, smarter networking and debrid hosts — what B Download Manager does now."
>
  <ToolbarFeature />

  <section class="features-new" aria-labelledby="features-new-title">
    <div class="container-page">
      <header class="new-head reveal">
        <p class="eyebrow">New in 1.2.0 and 1.2.1</p>
        <h2 id="features-new-title" class="new-title">What just landed.</h2>
        <p class="new-copy">
          Every release since 1.1, in plain words, each with the pane it
          lives in — drawn at the app's own size and palette.
        </p>
      </header>

      <div class="feat-grid">
        {
          features.map((f, i) => (
            <article class:list={["feat", "reveal", f.wide && "feat--wide"]} aria-labelledby={`feat-${f.id}`}>
              <div class="feat-shot">
                <img
                  src={`/images/features/${f.id}.webp`}
                  width={f.wide ? 2464 : 1344}
                  height={f.wide ? 904 : 864}
                  alt={f.alt}
                  loading={i < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              </div>
              <h3 id={`feat-${f.id}`} class="feat-title">
                {f.title}
              </h3>
              <p class="feat-copy">{f.copy}</p>
              <ul class="feat-points">
                {f.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section features-more" aria-labelledby="features-more-title">
    <div class="container-page">
      <div class="more-band reveal">
        <p class="eyebrow">Keep going</p>
        <h2 id="features-more-title" class="more-title">
          Every release adds more.
        </h2>
        <p class="more-copy">
          Notes for each version ship in the app under Help, What's new, and
          on the releases page. Your phone and your assistant are next.
        </p>
        <div class="more-action">
          <Button href={RELEASES_URL} variant="secondary" icon="arrow-right">
            Read the release notes
          </Button>
          <Button href={RELEASES_URL} variant="primary" icon="download">
            Download
          </Button>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  .features-new {
    padding-bottom: var(--section-space);
  }

  .new-head {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .new-title {
    margin-top: 1.1rem;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-section);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .new-copy {
    max-width: 44ch;
    margin: 1.25rem auto 0;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: 1.65;
  }

  .feat-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .feat--wide {
    grid-column: 1 / -1;
  }

  .feat--wide .feat-copy {
    max-width: 62ch;
  }

  .feat-shot {
    overflow: hidden;
    border-radius: var(--radius-md);
    background-color: var(--figure-bg);
    box-shadow: var(--shadow-panel);
  }

  .feat-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  .feat-title {
    margin-top: 1.4rem;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-step);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
  }

  .feat-copy {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: 1.65;
  }

  .feat-points {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .feat-points li {
    position: relative;
    margin-top: 0.45rem;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: var(--type-small);
    line-height: 1.6;
  }

  .feat-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .features-more {
    padding-bottom: var(--section-space);
  }

  .more-band {
    max-width: 56rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 5vw, 4rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    text-align: center;
  }

  .more-title {
    margin-top: 1rem;
    color: var(--ink);
    font-family: var(--face-display);
    font-size: var(--type-section);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .more-copy {
    max-width: 44ch;
    margin: 1.25rem auto 0;
    color: var(--muted);
    font-size: var(--type-body);
    line-height: 1.65;
  }

  .more-action {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (max-width: 64rem) {
    .feat-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>