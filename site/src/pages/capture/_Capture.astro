---
// Bare stage for scripts/record-hero.mjs: the hero at its exact design size,
// one play per load, no page chrome. Not linked anywhere; the landing hero
// ships the recorded video instead. The page ground matches the landing
// palette so the baked background is invisible in that theme.
import "../../styles/fonts.css";
import DownloadHero from "../../components/stageshow/hero/download-hero";

const { layout, theme = "light" } = Astro.props;
const width = layout === "compact" ? 358 : 1120;
const height = layout === "compact" ? 330 : 540;
const ground = theme === "dark" ? "#0c0a09" : "#f6f4f1";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/images/app-icon.png" />
    <title>hero capture</title>
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body style={`background:${ground}`}>
    <div style={`width:${width}px;height:${height}px`}>
      <DownloadHero client:load />
    </div>
  </body>
</html>