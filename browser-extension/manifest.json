{
  "manifest_version": 3,
  "name": "Internet Download Manager Integration",
  "version": "0.1.0",
  "description": "Hands links and downloads to my-idm-clone, the way the IDM extension does.",
  "permissions": ["contextMenus", "downloads", "storage"],
  "host_permissions": ["http://127.0.0.1:27500/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Internet Download Manager",
    "default_popup": "popup.html"
  }
}
