{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "B Download Manager",
  "version": "0.1.0",
  "identifier": "com.example.myidmclone",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "B Download Manager",
        "decorations": false,
        "width": 1180,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#0b1416"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
